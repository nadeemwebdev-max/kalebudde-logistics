# Copy to .env and adjust for your environment.

# Postgres (production). Leave unset to fall back to local SQLite for quick demos.
DATABASE_URL=postgresql+psycopg2://kalebudde:kalebudde_secret@localhost:5432/kalebudde

# IMPORTANT: generate with `openssl rand -hex 32`
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

SITE_URL=https://kalebuddelogistics.in
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Seeded on first boot only
SEED_ADMIN_EMAIL=admin@kalebuddelogistics.in
SEED_ADMIN_PASSWORD=Admin@12345
