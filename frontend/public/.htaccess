# MIME Types for JavaScript modules and CSS
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>

# Single Page Application (SPA) Routing Rewrite Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Serve existing files and directories directly without rewrite
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback all other SPA route requests to index.html
  RewriteRule ^ index.html [L]
</IfModule>
